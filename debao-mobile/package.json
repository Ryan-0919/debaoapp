    "harmony:run": "react-native run-harmony",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "doctor": "react-native doctor"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.21.0",
