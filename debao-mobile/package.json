    "harmony:link": "react-native link-harmony --include-npm-packages @react-native-oh-tpl/async-storage @react-native-oh-tpl/react-native-safe-area-context @react-native-oh-tpl/react-native-screens @react-native-oh-tpl/react-native-svg && node scripts/postlink-harmony.mjs",
