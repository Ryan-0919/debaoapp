    "@react-navigation/native-stack": "6.11.0",
    "lucide-react-native": "1.34.0",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-safe-area-context": "4.7.4",
    "react-native-screens": "3.34.0",
    "react-native-svg": "15.0.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native-oh/react-native-harmony-cli": "0.82.30",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/eslint-config": "0.82.1",
    "@react-native/gradle-plugin": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@types/jest": "^29.5.13",
    "@types/node": "22.19.17",
    "@types/react": "^19.1.1",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "5.0.2",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.1",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.19.4 <23"
  },
  "pnpm": {
    "patchedDependencies": {
      "@react-native/gradle-plugin@0.82.1": "patches/@react-native__gradle-plugin@0.82.1.patch",
      "@react-native-oh-tpl/async-storage@1.21.0-0.2.2": "patches/@react-native-oh-tpl__async-storage@1.21.0-0.2.2.patch",
