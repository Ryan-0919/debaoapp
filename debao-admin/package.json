{
  "name": "debao-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "max dev",
    "build": "max build",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:types": "openapi-typescript ../debao-server/openapi.yaml -o src/services/openapi.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/pro-components": "^2.8.10",
    "@umijs/max": "^4.4.12",
    "antd": "^5.27.0",
    "dayjs": "1.11.23",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.5",
    "exceljs": "^4.4.0",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.30.0",
    "openapi-typescript": "^7.8.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
