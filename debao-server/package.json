{
  "name": "debao-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "node scripts/migrate.mjs",
    "admin:init": "node scripts/init-admin.mjs",
    "test": "npm run build && DEBAO_TEST_FIXTURES=true node --test dist/test/*.test.js scripts/migration-mode.test.mjs",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@types/pg": "8.15.5",
    "@types/node": "22.19.17",
    "ioredis": "5.6.1",
    "pg": "8.16.3",
    "tsx": "4.19.3",
    "typescript": "5.8.3"
  }
}
